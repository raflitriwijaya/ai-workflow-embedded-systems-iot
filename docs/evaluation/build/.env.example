# =============================================================================
# Evaluation Harness — environment template. Copy to `.env` and fill in secrets.
#   cp .env.example .env
# NEVER commit the real .env. All credentials are injected via these vars only
# (task constraint: "No hardcoded credentials — use environment variables").
# =============================================================================

# ── PostgreSQL (owned by the harness; isolated from production) ──────────────
HARNESS_DB_NAME=eval_harness
HARNESS_DB_USER=harness
HARNESS_DB_PASSWORD=change-me-strong-password
HARNESS_DB_HOST=db
HARNESS_DB_PORT=5432
HARNESS_DB_SSLMODE=disable

# Assembled DSN consumed by the app/migrator (or set DATABASE_URL directly).
DATABASE_URL=postgresql://harness:change-me-strong-password@db:5432/eval_harness
PGHOST=db
PGPORT=5432
PGDATABASE=eval_harness
PGUSER=harness
PGPASSWORD=change-me-strong-password

# ── Grafana (read-only DB role + admin login) ────────────────────────────────
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=change-me-grafana-ro

# ── API ───────────────────────────────────────────────────────────────────────
HARNESS_API_PORT=8080
HARNESS_BLIND_SCORING=true
HARNESS_RUBRIC_VERSION=v1
HARNESS_LOG_FORMAT=json
HARNESS_LOG_LEVEL=INFO

# ── Statistical engine cadence (seconds; spec §2.3 = hourly) ─────────────────
HARNESS_STATS_INTERVAL=3600

# ── Artifact store (local file:// by default; MinIO/S3 optional) ─────────────
HARNESS_ARTIFACT_STORE=file:///var/harness/artifacts
# Uncomment + run `docker compose --profile objectstore up` for MinIO:
# HARNESS_ARTIFACT_STORE=s3://eval-harness
# S3_ENDPOINT_URL=http://minio:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=change-me-minio
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=change-me-minio
